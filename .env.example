# ── LOCAL DEV (docker-compose) ──────────────────────────────────────────────
# Backend
DATABASE_URL=postgres://todo:todo@postgres:5433/todo
JWT_SECRET=local-dev-secret-change-in-production
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:4001
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Frontend
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# ── PRODUCTION ───────────────────────────────────────────────────────────────
# Database:  Neon (https://neon.tech)
# Backend:   Render  → https://shared-todo-backend.onrender.com
# Frontend:  Vercel  → https://shared-todo-maor765.vercel.app
#
# Backend env vars (set in Render dashboard):
#   DATABASE_URL=postgresql://neondb_owner:<pass>@<host>.neon.tech/neondb?sslmode=require
#   JWT_SECRET=<48+ random bytes — openssl rand -base64 48>
#   FRONTEND_URL=https://shared-todo-maor765.vercel.app
#   GOOGLE_CLIENT_ID=<from Google Cloud Console>
#   NODE_ENV=production
#
# Frontend env vars (set in Vercel dashboard, baked at build time):
#   VITE_API_URL=https://shared-todo-backend.onrender.com
#   VITE_GOOGLE_CLIENT_ID=<from Google Cloud Console>
